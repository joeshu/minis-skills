name: Build unsigned IPA

on:
  push:
    branches: [ {{ branch }} ]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    defaults:
      run:
        working-directory: ${{ github.workspace }}/{{ project_dir }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Restore cached DerivedData
        uses: actions/cache@v4
        with:
          path: ~/Library/Developer/Xcode/DerivedData
          key: ${{ runner.os }}-deriveddata-${{ hashFiles('**/*.swift', '**/*.xcodeproj') }}
          restore-keys: |
            ${{ runner.os }}-deriveddata-

      - name: Set up Swift
        uses: swift-actions/setup-swift@v2
        with:
          swift-version: '6.0'

      - name: Install XcodeGen
        run: brew install xcodegen

      - name: Generate Xcode project
        run: xcodegen generate

      - name: Build archive
        run: |
          xcodebuild -scheme "{{ scheme }}" \
            -configuration Release \
            -destination generic/platform=iOS \
            -archivePath ${{ runner.temp }}/DemoApp.xcarchive \
            archive

      - name: Export unsigned IPA
        run: |
          xcodebuild -exportArchive \
            -archivePath ${{ runner.temp }}/DemoApp.xcarchive \
            -exportOptionsPlist DemoApp/ExportOptions.plist \
            -exportPath ${{ runner.temp }}/out

      - name: Compute SHA256 checksum
        run: |
          shasum -a 256 ${{ runner.temp }}/out/{{ artifact_name }} > checksum.txt

      - name: Upload IPA artifact
        uses: actions/upload-artifact@v4
        with:
          name: {{ artifact_name }}
          path: ${{ runner.temp }}/out/{{ artifact_name }}

      - name: Upload checksum
        uses: actions/upload-artifact@v4
        with:
          name: checksum.txt
          path: checksum.txt

      - name: Generate CI summary
        run: |
          python3 post_process.py